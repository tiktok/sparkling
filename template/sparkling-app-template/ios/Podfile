platform :ios, '12.0'

source 'https://cdn.cocoapods.org/'

use_modular_headers!

plugin 'cocoapods-lynx-library'

install! 'cocoapods',
:generate_multiple_pod_projects => true,
:incremental_installation => true,
:deterministic_uuids => true

inhibit_all_warnings!

def ensure_embed_pods_frameworks_phase(project, target_name, pods_target_name)
  frameworks_script = File.join(
    __dir__,
    'Pods',
    'Target Support Files',
    pods_target_name,
    "#{pods_target_name}-frameworks.sh"
  )
  return unless File.exist?(frameworks_script)

  target = project.targets.find { |candidate| candidate.name == target_name }
  return unless target

  phase_name = '[CP] Embed Pods Frameworks'
  phase = target.shell_script_build_phases.find { |candidate| candidate.name == phase_name }
  phase ||= target.new_shell_script_build_phase(phase_name)
  phase.input_file_list_paths = [
    "${PODS_ROOT}/Target Support Files/#{pods_target_name}/#{pods_target_name}-frameworks-${CONFIGURATION}-input-files.xcfilelist"
  ]
  phase.output_file_list_paths = [
    "${PODS_ROOT}/Target Support Files/#{pods_target_name}/#{pods_target_name}-frameworks-${CONFIGURATION}-output-files.xcfilelist"
  ]
  phase.shell_script = "\"${PODS_ROOT}/Target Support Files/#{pods_target_name}/#{pods_target_name}-frameworks.sh\"\n"
  phase.show_env_vars_in_log = '0'
end

def sparkling_methods
  pod 'SparklingMethod', '2.1.0-rc.12', :subspecs => ['Lynx', 'DIProvider', 'Debug']
end

def sparkling_methods_dep
  # BEGIN SPARKLING AUTOLINK
  pod 'Sparkling-Router', '2.1.0-rc.12'
  # END SPARKLING AUTOLINK
end

def sparkling_devtool
  pod 'Sparkling-DebugTool', '2.1.0-rc.12'
  # BEGIN SPARKLING AUTOLINK
  # No extra devtool modules
  # END SPARKLING AUTOLINK
  pod 'DebugRouter', '5.0.15'
  pod 'DebugRouter/MessageTransceiverEnable', '5.0.15'
end

def sparkling_kit
  use_lynx_library!

  pod 'Sparkling', '2.1.0-rc.12'
  pod 'SparklingMacro', '2.1.0-rc.12'
  sparkling_methods
  sparkling_methods_dep

  pod 'Lynx', '3.9.0', :subspecs => [
    'Framework',
    'ReleaseResource'
  ]

  pod 'PrimJS', '3.8.0-alpha.6', :subspecs => ['quickjs', 'napi']

  pod 'LynxService', '3.9.0', :subspecs => [
    'Image',
    'Log',
    'Http',
  ]

  pod 'SnapKit', '5.7.1'
  pod 'Mantle', '2.2.0'

  pod 'SDWebImage','5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'
end

use_frameworks! :linkage => :static

# SparklingGo is the production-style target: no devtool dependencies are
# linked, so DebugRouter / LynxDevtool symbols cannot leak into a Release
# build. Use SparklingGoInHouse for day-to-day development (it is what
# `pnpm run:ios` builds).
target 'SparklingGo' do
  sparkling_kit

  target 'SparklingGoTests' do
    inherit! :search_paths
  end

  target 'SparklingMethodTests' do
    inherit! :search_paths
  end

  target 'SparklingGoUITests' do
    inherit! :search_paths
  end
end

target 'SparklingGoInHouse' do
  sparkling_kit
  sparkling_devtool
end

post_install do |installer|
  project = Xcodeproj::Project.open(File.join(__dir__, 'SparklingGo.xcodeproj'))
  ensure_embed_pods_frameworks_phase(project, 'SparklingGo', 'Pods-SparklingGo')
  ensure_embed_pods_frameworks_phase(project, 'SparklingGoInHouse', 'Pods-SparklingGoInHouse')
  project.save
end
