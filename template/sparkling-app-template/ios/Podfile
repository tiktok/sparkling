platform :ios, '12.0'

source 'https://cdn.cocoapods.org/'

use_modular_headers!

install! 'cocoapods',
:generate_multiple_pod_projects => true,
:incremental_installation => true,
:deterministic_uuids => true

inhibit_all_warnings!

def sparkling_methods
  pod 'SparklingMethod', '2.1.0-rc.12', :subspecs => ['Lynx', 'DIProvider', 'Debug']
end

def sparkling_methods_dep
  # BEGIN SPARKLING AUTOLINK
  pod 'Sparkling-Router', '2.1.0-rc.12'
  # END SPARKLING AUTOLINK
end

def sparkling_devtool
  # BEGIN SPARKLING AUTOLINK
  pod 'Sparkling-DebugTool', '2.1.0-rc.12'
  # END SPARKLING AUTOLINK
  pod 'DebugRouter', '5.0.15'
  pod 'DebugRouter/MessageTransceiverEnable', '5.0.15'
end

def sparkling_kit
  pod 'Sparkling', '2.1.0-rc.12'
  pod 'SparklingMacro', '2.1.0-rc.12'
  sparkling_methods
  sparkling_methods_dep

  pod 'Lynx', '3.7.0', :subspecs => [
    'Framework',
    'ReleaseResource'
  ]

  pod 'PrimJS', '3.7.0', :subspecs => ['quickjs', 'napi']

  pod 'LynxService', '3.7.0', :subspecs => [
    'Image',
    'Log',
    'Http',
  ]

  pod 'SnapKit', '5.7.1'
  pod 'Mantle', '2.2.0'

  pod 'SDWebImage','5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'
end

use_frameworks!

# SparklingGo is the production-style target: no devtool dependencies are
# linked, so DebugRouter / LynxDevtool symbols cannot leak into a Release
# build. Use SparklingGoInHouse for day-to-day development (it is what
# `pnpm run:ios` builds).
target 'SparklingGo' do
  sparkling_kit
end

target 'SparklingGoInHouse' do
  sparkling_kit
  sparkling_devtool
end

target 'SparklingGoTests' do
  sparkling_kit
end

target 'SparklingMethodTests' do
  sparkling_kit
end

target 'SparklingGoUITests' do
  sparkling_kit
end

post_install do |installer|
  # LynxServiceAPI 3.7.0 ships a podspec whose HEADER_SEARCH_PATHS only
  # contains the CI builder's absolute path. service_api/service_api.cc
  # does `#include "service_api/service_api.h"`, which needs the pod's
  # own root in the search paths to resolve locally.
  # This has been fixed upstream in Lynx 3.8.0 — remove this workaround
  # once Lynx 3.8 stable is released.
  Dir.glob(File.join(__dir__, 'Pods/Target Support Files/LynxServiceAPI/LynxServiceAPI.*.xcconfig')) do |path|
    content = File.read(path)
    next if content.include?('${PODS_TARGET_SRCROOT}')
    patched = content.sub(/^(HEADER_SEARCH_PATHS\s*=\s*.*)$/) { "#{$1} \"${PODS_TARGET_SRCROOT}\"" }
    File.write(path, patched) if patched != content
  end
end
