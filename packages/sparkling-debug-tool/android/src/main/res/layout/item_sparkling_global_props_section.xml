<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:background="@color/sparkling_panel_section_bg">

    <TextView
        android:id="@+id/txt_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/sparkling_panel_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_section_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/sparkling_panel_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
