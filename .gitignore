# Local
.DS_Store
.pnpm-store
*.local
*.log*

# Dist
node_modules
dist/
output/
output_resource/
**/doc_build
**/*.lynx.bundle

docs/**/*.html

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Template: the template's .gitignore is stored without a leading dot so that
# npm can publish it correctly. Git won't recognise it, so we duplicate the
# necessary ignore rules here for local development.
template/sparkling-app-template/android/app/src/main/assets/static/
template/sparkling-app-template/ios/LynxResources/static/
template/sparkling-app-template/.sparkling/
template/sparkling-app-template/android/**/build/
template/sparkling-app-template/android/.gradle/
template/sparkling-app-template/ios/build/
template/sparkling-app-template/ios/DerivedData/
template/sparkling-app-template/ios/Pods/
packages/methods/ios-unit-tests/Pods/
packages/methods/ios-unit-tests/*.xcworkspace/
packages/methods/ios-unit-tests/build/
# ios/Podfile.lock is intentionally tracked: the release pipeline regenerates
# and commits it. It stays ignored only inside generated apps, via the
# template's own ios/gitignore.
template/sparkling-app-template/coverage/
template/sparkling-app-template/vendor/bundle/
template/sparkling-app-template/.bundle/

tsconfig.tsbuildinfo

# Internal test helpers live as TS source only; prevent accidental in-place emits.
packages/common/test-utils/*.js
packages/common/test-utils/*.js.map
packages/common/test-utils/*.d.ts
packages/common/test-utils/*.d.ts.map

# Build artifacts
.temp-templates/
.e2e-artifacts/
coverage-reports/

# Local Xcode overrides (per-developer signing, etc.)
**/Local.xcconfig

# Python
__pycache__/
